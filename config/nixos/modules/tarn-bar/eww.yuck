;; `out` is this bar's output connector name, such that the workspaces widget
;; can tell whether a workspace is active on this output or a different output
(defwidget bar [out]
  (centerbox :class "bar" :orientation "h"
    (workspaces :out out)
    (window_title)
    (sidestuff)))

(defwidget sidestuff []
  (box :class "sidestuff" :orientation "h" :space-evenly false :halign "end"
    (systray :class "generic")
    (generic :label "net"
             :value "${round(net_throughput.down / (1024*1024), 2)}/${round(net_throughput.up / (1024*1024), 2)} MiB/s")
    ; (metric :label "S"
    ;         :value volume
    ;         :onchange "amixer -D pulse sset Master {}%")
    (metric :label "ram"
            :value {EWW_RAM.used_mem_perc}
            :onchange "")
    (metric :label "cpu"
            :value {EWW_CPU.avg}
            :onchange "")
    ;; EWW_BATTERY is empty on systems without a battery.
    (box :visible {EWW_BATTERY != ""}
      (metric :label "bat"
              :value {EWW_BATTERY?.total_avg ?: 0}
              :onchange ""))
    time))

;; Down/up bytes per second over all device-backed interfaces.
(deflisten net_throughput :initial '{"down":0,"up":0}' "@getNetThroughput@")

(deflisten window_title :initial "1" "@tarnTitle@")
(defwidget window_title [] (box (label :text "${window_title}" :truncate true)))

(deflisten workspaces :initial "[]" "@getWorkspaces@")
(defwidget workspaces [out]
  (box :space-evenly false
  (label :text "${workspaces}" :visible false)
    (for workspace in workspaces
      ;; current = active on THIS output; other = active on a different output.
      (box :class "workspace-entry ${workspace.active && workspace.output == out ? "current" : (workspace.active ? "other" : "")} ${workspace.occupied ? "occupied" : "empty"}"
        (button :onclick "@tarn@ msg activate ${workspace.id}" "${workspace.id}"))
      ; (box :class "workspace-entry ${workspace.id == current_workspace ? "current" : ""} ${workspace.windows > 0 ? "occupied" : "empty"}"
      ;   (button :onclick "hyprctl dispatch workspace ${workspace.id}" "${workspace.id}"))
    )))

(defwidget music []
  (box :class "music"
       :orientation "h"
       :space-evenly false
       :halign "center"
    {music != "" ? "🎵${music}" : ""}))

(defwidget generic [label value]
  (box :orientation "h"
       :class "generic"
       :space-evenly false
    (box :class "label" label)
    (box :class "value" value)))

(defwidget metric [label value onchange]
  (box :orientation "h"
       :class "metric"
       :space-evenly false
    (box :class "label" label)
    (scale :min 0
           :max 101
           :active {onchange != ""}
           :value value
           :onchange onchange)))

(deflisten music :initial ""
  "playerctl --follow metadata --format '{{ artist }} - {{ title }}' || true")

(defpoll volume :interval "1s"
  "scripts/getvol")

(defpoll time :interval "10s"
  "date '+%b %d %H:%M'")

(defwindow bar [out]
  :monitor 0
  :stacking "fg"
  :exclusive true
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "30px"
                      :anchor "top center")
  (bar :out out))
